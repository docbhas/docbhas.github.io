---
import Base from '../layouts/Base.astro';
import { pillars, site, videos } from '../data/site';
---
<Base>
  <!--
    Three threads (clinical informatics · medical science · human understanding):
    they meet in the BHS mark, intertwine down the page, then split, one into each pillar card.
    The lower threads are drawn by the script at the bottom from the real card positions.
  -->
  <div class="journey" id="journey">
    <svg class="journey-svg" aria-hidden="true"><g id="journey-paths"></g></svg>

    <section class="hero">
      <div class="mark-zone">
        <svg class="threads" viewBox="0 0 1200 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
          <path pathLength="1" d="M-20 70 C 260 80, 420 120, 520 170 C 560 190, 580 200, 600 210" stroke="var(--emerald)" />
          <path pathLength="1" d="M600 -10 L600 210" stroke="var(--sage)" class="mid" />
          <path pathLength="1" d="M1220 70 C 940 80, 780 120, 680 170 C 640 190, 620 200, 600 210" stroke="var(--gold)" />
        </svg>
        <div class="halo"></div>
        <img class="mark" src="/brand/bhs-mark-animated.svg" alt="BHS logo" width="340" height="350" />
      </div>

      <div class="wrap hero-copy">
        <h1>Build · Heal · Share</h1>
        <p class="statement serif">
          Bringing together medical science, clinical informatics, and human understanding to create more holistic
          and compassionate care.
        </p>
        <ul class="strands" aria-label="What comes together">
          <li class="s1">Clinical informatics</li>
          <li class="s2">Medical science</li>
          <li class="s3">Human understanding</li>
        </ul>
        <div class="ctas">
          <a class="btn btn-primary" href="/about/">Start here</a>
          <a class="btn btn-ghost" href="/work/">See my work</a>
        </div>
      </div>
      <div class="thread-start" id="thread-start" aria-hidden="true"></div>
    </section>

    <!-- Intro -->
    <section class="wrap intro-sec">
      <div class="intro card lift">
        <div class="portrait">
          <img src="/images/portrait.webp" alt="Portrait of Gus Bhas in a white coat" width="720" height="664" loading="eager" />
        </div>
        <div>
          <h2 class="serif">Hi, I'm Gus Bhas.</h2>
          <p>
            I'm an internist-in-training, a curious clinical developer, and a lifelong learner exploring the
            intersection of clinical medicine, health informatics, creativity, and human connection.
          </p>
          <a class="link" href="/about/">Read my story →</a>
        </div>
      </div>
    </section>

    <!-- Pillars -->
    <section class="wrap pillars-sec">
      <p class="bridge serif" id="bridge">“Every path starts with a question. Only the form of the answer changes.”</p>
      <div class="pillars">
        {pillars.map((p) => (
          <article class={`pillar card lift ${p.key}`} data-thread={p.key}>
            <p class="eyebrow num">{p.num} · {p.label}</p>
            <h3 class="serif">{p.question}</h3>
            <p class="body">{p.body}</p>
            <div class="thumb"><img src={p.img.src} alt={p.img.alt} loading="lazy" width="900" height="600" style={`--pos: ${p.img.pos}`} /></div>
            <ul>{p.points.map((pt) => <li>{pt}</li>)}</ul>
            <a class="link" href={p.cta.href} {...(p.cta.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>
              {p.cta.label} →
            </a>
          </article>
        ))}
      </div>
    </section>
  </div>

  <!-- Earlier explainer videos -->
  <section class="wrap shared">
    <div class="videos-head">
      <p class="eyebrow kicker">Share, before BHS</p>
      <h2 class="serif">Explainer videos</h2>
      <p>An earlier project, made before BHS: animated explainers on clinical reasoning, in Indonesian.</p>
    </div>
    <div class="videos">
      {videos.map((v) => (
        <div class="video card lift">
          <button class="yt" type="button" data-id={v.id} aria-label={`Play video: ${v.title}`}>
            <img src={`https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`} alt="" loading="lazy" width="480" height="360" />
            <span class="play" aria-hidden="true"></span>
          </button>
          <div class="vmeta">
            <span class="t">{v.title}</span>
            <span class="s">{v.date}</span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- MEDIx highlight -->
  <section class="wrap">
    <a class="medix lift" href={site.medix} target="_blank" rel="noopener">
      <img src="/brand/medix-icon-light.svg" alt="" width="64" height="64" />
      <div>
        <h2>From clinical questions to practical tools.</h2>
        <p>Each tool explains its intended use, suitable population, sources, and limitations before it is used.</p>
      </div>
      <span class="link">Explore MEDIx →</span>
    </a>
  </section>

  <!-- Closing -->
  <section class="wrap closing">
    <h2 class="serif">Let's keep learning together.</h2>
    <p>Conversations about medicine, data, and how to make both more human are always welcome.</p>
    <div class="ctas">
      <a class="btn btn-primary" href="/contact/">Get in touch</a>
      <a class="btn btn-ghost" href={site.instagram} target="_blank" rel="noopener">{site.handle}</a>
    </div>
  </section>
</Base>

<script>
  // ---------- Threads: intertwine from the hero, then split into the three pillar cards ----------
  const COLORS: Record<string, string> = { build: 'var(--emerald)', heal: 'var(--sage)', share: 'var(--gold)' };
  const ORDER = ['build', 'heal', 'share'];
  const journey = document.getElementById('journey')!;
  const group = document.getElementById('journey-paths')!;
  const start = document.getElementById('thread-start')!;
  const bridge = document.getElementById('bridge')!;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let drawn = false;

  function draw() {
    const box = journey.getBoundingClientRect();
    const rel = (r: DOMRect) => ({ x: r.left - box.left, y: r.top - box.top, w: r.width, h: r.height });
    const s = rel(start.getBoundingClientRect());
    const b = rel(bridge.getBoundingClientRect());
    const cx = s.x + s.w / 2;
    const y0 = s.y;
    const y1 = b.y + b.h + 18; // threads unweave just below the bridge sentence
    const amp = Math.min(46, box.width * 0.07);
    const period = 220;

    group.innerHTML = '';
    ORDER.forEach((key, i) => {
      const card = document.querySelector(`[data-thread="${key}"]`);
      if (!card) return;
      const c = rel(card.getBoundingClientRect());
      const phase = (i * 2 * Math.PI) / 3;
      // Braid: three sine waves 120° apart, amplitude easing in and out.
      let d = '';
      for (let y = y0; y <= y1; y += 8) {
        const t = (y - y0) / (y1 - y0);
        const x = cx + amp * Math.sin(Math.PI * t) * Math.sin((2 * Math.PI * (y - y0)) / period + phase);
        d += `${d ? 'L' : 'M'}${x.toFixed(1)} ${y.toFixed(1)} `;
      }
      // Split: curve from the end of the braid to the top centre of this card.
      const tx = c.x + c.w / 2, ty = c.y + 3;
      const my = (y1 + ty) / 2;
      d += `C${cx.toFixed(1)} ${my.toFixed(1)} ${tx.toFixed(1)} ${my.toFixed(1)} ${tx.toFixed(1)} ${ty.toFixed(1)}`;

      const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      path.setAttribute('d', d);
      path.setAttribute('stroke', COLORS[key]);
      path.setAttribute('pathLength', '1');
      path.dataset.thread = key;
      if (drawn || reduced) path.classList.add('on');
      group.appendChild(path);
    });
  }

  draw();
  new ResizeObserver(draw).observe(journey);
  // Draw the braid once the intro scrolls into view.
  new IntersectionObserver((entries, io) => {
    if (entries.some((e) => e.isIntersecting)) {
      drawn = true;
      group.querySelectorAll('path').forEach((p) => p.classList.add('on'));
      io.disconnect();
    }
  }, { threshold: 0.2 }).observe(document.querySelector('.intro')!);

  // Hovering a pillar card highlights its own thread.
  document.querySelectorAll<HTMLElement>('[data-thread]').forEach((card) => {
    if (card.tagName === 'path') return;
    const key = card.dataset.thread;
    const toggle = (on: boolean) => {
      group.querySelector(`path[data-thread="${key}"]`)?.classList.toggle('hot', on);
      group.classList.toggle('dim', on);
    };
    card.addEventListener('mouseenter', () => toggle(true));
    card.addEventListener('mouseleave', () => toggle(false));
    card.addEventListener('focusin', () => toggle(true));
    card.addEventListener('focusout', () => toggle(false));
  });

  // ---------- Videos: load the YouTube player only after a click ----------
  document.querySelectorAll<HTMLButtonElement>('.yt').forEach((btn) => {
    btn.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${btn.dataset.id}?autoplay=1&rel=0`;
      iframe.title = btn.getAttribute('aria-label')?.replace('Play video: ', '') ?? 'Video';
      iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      btn.replaceWith(iframe);
    });
  });
</script>

<style>
  /* ---------- shared hover ---------- */
  .lift { transition: transform .35s cubic-bezier(.2, .8, .2, 1), box-shadow .35s, border-color .35s; }
  .lift:hover, .lift:focus-within {
    transform: translateY(-6px);
    box-shadow: 0 18px 40px -18px rgb(2 44 34 / .35);
    border-color: rgb(2 44 34 / .18);
  }

  /* ---------- journey threads ---------- */
  .journey { position: relative; }
  .journey > section { position: relative; z-index: 1; }
  .journey-svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; z-index: 0; pointer-events: none; }
  .journey-svg :global(path) {
    fill: none; stroke-width: 3; stroke-linecap: round; stroke-linejoin: round;
    stroke-dasharray: 1; stroke-dashoffset: 1;
    transition: stroke-dashoffset 2.6s cubic-bezier(.45, 0, .25, 1), opacity .3s, stroke-width .3s;
  }
  .journey-svg :global(path.on) { stroke-dashoffset: 0; }
  .journey-svg :global(g.dim path) { opacity: .25; }
  .journey-svg :global(g.dim path.hot) { opacity: 1; stroke-width: 5; }

  /* ---------- hero ---------- */
  .hero { text-align: center; margin-top: -88px; padding-top: 88px; }
  .mark-zone { position: relative; height: 300px; }
  .threads { position: absolute; inset: 0; width: 100%; height: 100%; }
  .threads path {
    fill: none; stroke-width: 3; stroke-linecap: round;
    stroke-dasharray: 1; stroke-dashoffset: 1;
    animation: draw 1.8s cubic-bezier(.45, 0, .25, 1) .1s forwards;
  }
  .threads path.mid { stroke-width: 4; opacity: .8; }
  .halo {
    position: absolute; left: 50%; top: 210px; width: 220px; height: 220px;
    translate: -50% -50%; border-radius: 50%; background: var(--ivory);
  }
  .mark { position: absolute; left: 50%; top: 210px; width: 190px; height: auto; translate: -50% -50%; }
  .hero-copy { position: relative; margin-top: 40px; }
  h1 {
    font-weight: 800; letter-spacing: -.03em; font-size: clamp(40px, 7.4vw, 80px);
    opacity: 0; animation: rise .9s ease-out 1.6s forwards;
  }
  .statement {
    font-style: italic; font-size: clamp(18px, 2.2vw, 22px); color: var(--slate);
    max-width: 680px; margin: 18px auto 0;
    opacity: 0; animation: rise .9s ease-out 1.9s forwards;
  }
  .strands {
    display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 28px;
    list-style: none; padding: 0; margin: 32px 0 0;
    font-size: 12px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase;
  }
  .strands li { display: flex; align-items: center; gap: 8px; }
  .strands li::before { content: ''; width: 18px; height: 3px; border-radius: 2px; }
  .s1 { color: var(--emerald); } .s1::before { background: var(--emerald); }
  .s2 { color: var(--sage-text); } .s2::before { background: var(--sage); }
  .s3 { color: var(--gold-text); } .s3::before { background: var(--gold); }
  .ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; margin-top: 32px; }
  .thread-start { height: 56px; margin-top: 20px; }

  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes rise { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .threads path { stroke-dashoffset: 0; }
    h1, .statement { opacity: 1; }
  }

  /* ---------- intro ---------- */
  .intro-sec { padding-top: 40px; }
  .intro {
    display: grid; grid-template-columns: 200px 1fr; gap: 36px; align-items: center;
    max-width: 860px; margin: 0 auto; padding: 28px 36px; border-radius: 24px;
  }
  .portrait {
    width: 200px; aspect-ratio: 1; border-radius: 50%; overflow: hidden; position: relative;
    background: radial-gradient(circle at 50% 35%, #c9d6ca, var(--sage));
  }
  .portrait img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 8%; transform: scale(1.12) translateY(6%); transition: transform .5s; }
  .intro:hover .portrait img { transform: scale(1.18) translateY(5%); }
  .portrait::after {
    content: ''; position: absolute; top: 12px; right: 16px; width: 14px; height: 14px;
    border-radius: 50%; background: var(--gold); box-shadow: 0 0 0 4px var(--white);
  }
  .intro h2 { font-weight: 400; font-size: clamp(28px, 3.6vw, 38px); }
  .intro p { margin: 10px 0 14px; }

  /* ---------- pillars ---------- */
  .pillars-sec { padding: 72px 0 8px; }
  .bridge {
    text-align: center; font-style: italic; font-size: clamp(18px, 2.2vw, 21px); color: var(--forest);
    max-width: 640px; margin: 0 auto 96px; background: var(--ivory); padding: 6px 16px; border-radius: 12px;
  }
  .pillars { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; align-items: start; }
  .pillar { position: relative; overflow: hidden; padding: 26px 24px 22px; display: flex; flex-direction: column; }
  .pillar::before {
    content: ''; position: absolute; inset: 0 0 auto; height: 6px;
    transform-origin: left; transition: height .35s;
  }
  .pillar:hover::before, .pillar:focus-within::before { height: 10px; }
  .build::before { background: var(--emerald); } .build .num { color: var(--emerald); }
  .heal::before { background: var(--sage); } .heal .num { color: var(--sage-text); }
  .share::before { background: var(--gold); } .share .num { color: var(--gold-text); }
  .pillar h3 { font-weight: 400; font-size: 22px; margin-top: 10px; }
  .body { margin-top: 12px; font-size: 15px; line-height: 1.55; }
  .thumb { margin-top: 14px; border-radius: 12px; overflow: hidden; aspect-ratio: 16 / 9; background: var(--sage); }
  .thumb img { width: 100%; height: 100%; object-fit: cover; object-position: var(--pos, center); transition: transform .6s; }
  .pillar:hover .thumb img { transform: scale(1.06); }
  .pillar ul { margin: 14px 0 16px; padding-left: 18px; font-size: 14px; color: var(--forest); }
  .pillar .link { font-size: 15px; }
  .pillar .link, .medix .link { transition: letter-spacing .3s; }
  .pillar:hover .link, .medix:hover .link { letter-spacing: .02em; }

  /* ---------- shared ---------- */
  .shared { padding-top: 96px; }
  .kicker { color: var(--gold-text); }
  .videos-head h2 { font-weight: 400; font-size: clamp(28px, 3.6vw, 36px); margin-top: 6px; }
  .videos-head p { font-size: 15px; margin-top: 6px; color: var(--muted); }
  .videos { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 20px; }
  .video { overflow: hidden; }
  .yt, .video :global(iframe) { display: block; width: 100%; aspect-ratio: 16 / 9; border: 0; padding: 0; background: var(--forest); cursor: pointer; position: relative; }
  .yt img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s, opacity .3s; }
  .video:hover .yt img { transform: scale(1.05); opacity: .85; }
  .play {
    position: absolute; left: 50%; top: 50%; width: 58px; height: 58px; translate: -50% -50%;
    border-radius: 50%; background: rgb(255 255 255 / .92); transition: transform .3s;
  }
  .play::after {
    content: ''; position: absolute; left: 23px; top: 18px;
    border-left: 17px solid var(--emerald); border-top: 11px solid transparent; border-bottom: 11px solid transparent;
  }
  .video:hover .play { transform: scale(1.12); }
  .vmeta { padding: 14px 18px 16px; display: grid; gap: 3px; }
  .vmeta .t { color: var(--forest); font-weight: 600; font-size: 14px; line-height: 1.4; }

  /* ---------- MEDIx ---------- */
  .medix {
    display: grid; grid-template-columns: 64px 1fr auto; gap: 28px; align-items: center;
    margin-top: 72px; padding: 28px 32px; border-radius: var(--radius);
    background: var(--cool); border: 1px solid var(--mint-border); text-decoration: none;
  }
  .medix h2 { font-size: clamp(20px, 2.4vw, 24px); font-weight: 800; }
  .medix p { color: var(--muted); font-size: 15px; margin-top: 6px; }

  /* ---------- closing ---------- */
  .closing { text-align: center; padding: 96px 0 96px; }
  .closing h2 { font-weight: 400; font-size: clamp(30px, 4vw, 40px); }
  .closing p { margin-top: 12px; }

  @media (max-width: 900px) {
    .pillars { grid-template-columns: 1fr; max-width: 520px; margin: 0 auto; gap: 28px; }
    .videos { grid-template-columns: 1fr 1fr; }
    .medix { grid-template-columns: 56px 1fr; }
    .medix .link { grid-column: 2; }
  }
  @media (max-width: 640px) {
    .mark-zone { height: 240px; }
    .halo, .mark { top: 168px; }
    .halo { width: 170px; height: 170px; }
    .mark { width: 140px; }
    .intro { grid-template-columns: 1fr; text-align: center; padding: 28px 22px; gap: 18px; }
    .portrait { width: 160px; margin: 0 auto; }
    .videos { grid-template-columns: 1fr; }
    .medix { padding: 22px; gap: 18px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .lift:hover, .lift:focus-within { transform: none; }
  }
</style>
