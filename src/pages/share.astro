---
import Base from '../layouts/Base.astro';
import VideoGrid from '../components/VideoGrid.astro';
import { site } from '../data/site';
---
<Base title="Share" description="Learning notes on Instagram and earlier explainer videos on clinical reasoning.">
  <section class="wrap">
    <header class="page-head">
      <p class="eyebrow kicker">Share · Meaningfully</p>
      <h1>What I Share</h1>
      <p>
        Learning notes, the process of building tools, and the occasional explainer, made to be used, not just read.
      </p>
    </header>

    <a class="ig card lift" href={site.instagram} target="_blank" rel="me noopener">
      <img src="/images/health-talk.webp" alt="Gus Bhas giving a health talk with a microphone" width="1086" height="674" loading="eager" />
      <div class="ig-body">
        <span class="eyebrow">Now · Instagram</span>
        <span class="handle">{site.handle}</span>
        <p>
          Clinical clarity, medicine seen humanly, and notes on what I'm building, including what hasn't worked yet.
        </p>
        <span class="go">Follow on Instagram <i>→</i></span>
      </div>
    </a>

    <section class="past">
      <p class="eyebrow kicker">Before BHS · YouTube</p>
      <h2 class="serif">Explainer videos</h2>
      <p class="sub">
        An earlier project: animated explainers on clinical reasoning, in Indonesian, from the INTERNADDICT channel.
      </p>
      <VideoGrid />
    </section>
  </section>
</Base>

<style>
  .kicker { color: var(--share-text); }

  .ig {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); overflow: hidden;
    text-decoration: none; color: inherit; position: relative;
  }
  .ig::before { content: ''; position: absolute; inset: 0 0 auto; height: 6px; background: var(--share); z-index: 1; transition: height .35s; }
  .ig:hover::before { height: 10px; }
  .ig img { width: 100%; height: 100%; min-height: 260px; object-fit: cover; object-position: 55% 22%; }
  .ig-body { padding: clamp(24px, 4vw, 44px); display: grid; align-content: center; gap: 8px; }
  .ig-body .eyebrow { color: var(--muted); font-size: 11px; }
  .handle { font-size: clamp(30px, 4vw, 44px); font-weight: 800; color: var(--forest); letter-spacing: -.02em; }
  .ig-body p { font-size: 16px; color: var(--slate); }
  .go { margin-top: 8px; font-weight: 600; color: var(--share-text); }
  .go i { display: inline-block; font-style: normal; transition: transform .3s; }
  .ig:hover .go i { transform: translateX(4px); }

  .past { padding: 72px 0 96px; }
  .past h2 { font-weight: 400; font-size: clamp(28px, 3.6vw, 36px); margin-top: 6px; }
  .sub { font-size: 15px; color: var(--muted); margin: 6px 0 22px; }

  @media (max-width: 760px) {
    .ig { grid-template-columns: 1fr; }
    .ig img { height: 220px; min-height: 0; }
  }
</style>
