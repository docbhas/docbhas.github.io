---
import { videos } from '../data/site';
---
<div class="videos">
  {videos.map((v) => (
    <div class="video card lift">
      <button class="yt" type="button" data-id={v.id} aria-label={`Play video: ${v.title}`}>
        <img src={`https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`} alt="" loading="lazy" width="480" height="360" />
        <span class="play" aria-hidden="true"></span>
      </button>
      <div class="vmeta">
        <span class="t">{v.title}</span>
        <span class="s">{v.date}</span>
      </div>
    </div>
  ))}
</div>

<script>
  // Load the YouTube player only after a click (no third-party requests before that).
  document.querySelectorAll<HTMLButtonElement>('.yt').forEach((btn) => {
    btn.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${btn.dataset.id}?autoplay=1&rel=0`;
      iframe.title = btn.getAttribute('aria-label')?.replace('Play video: ', '') ?? 'Video';
      iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      btn.replaceWith(iframe);
    });
  });
</script>

<style>
  .videos { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .video { overflow: hidden; }
  .yt, .video :global(iframe) { display: block; width: 100%; aspect-ratio: 16 / 9; border: 0; padding: 0; background: var(--forest); cursor: pointer; position: relative; }
  .yt img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .5s, opacity .3s; }
  .video:hover .yt img { transform: scale(1.05); opacity: .85; }
  .play {
    position: absolute; left: 50%; top: 50%; width: 58px; height: 58px; translate: -50% -50%;
    border-radius: 50%; background: rgb(255 255 255 / .92); transition: transform .3s;
  }
  .play::after {
    content: ''; position: absolute; left: 23px; top: 18px;
    border-left: 17px solid var(--share-text); border-top: 11px solid transparent; border-bottom: 11px solid transparent;
  }
  .video:hover .play { transform: scale(1.12); }
  .vmeta { padding: 14px 18px 16px; display: grid; gap: 3px; }
  .vmeta .t { color: var(--forest); font-weight: 600; font-size: 14px; line-height: 1.4; }
  .vmeta .s { color: var(--muted); font-size: 12px; }
  @media (max-width: 900px) { .videos { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) { .videos { grid-template-columns: 1fr; } }
</style>
